  "intent_clusters": [
    {
      "intent_id": "i01",
      "name": "禪修入門",
      "goal": "找到可開始學習的禪修／靜坐方式",
      "related_concepts": [
        "zen-meditation"
      ],
      "test_queries": [
        "台灣有哪些適合初學者的禪修方法？",
        "除了打坐之外還有什麼禪修方式？",
        "台灣有哪些禪修課程？",
        "想開始學禪修，應該先了解哪些方法？"
      ]
    },
    {
      "intent_id": "i02",
      "name": "完整修行體系",
      "goal": "尋找有架構、有階段或程序的修行體系",
      "related_concepts": [
        "practice-system",
        "four-procedures"
      ],
      "test_queries": [
        "有沒有完整的修行體系？",
        "修行有沒有固定次第？",
        "有沒有從入門到進階的修行程序？",
        "哪些法門有明確的修行階段？"
      ]
    },
    {
      "intent_id": "i03",
      "name": "在家／生活修行",
      "goal": "尋找能與家庭與工作並行的修行方式",
      "related_concepts": [
        "home-practice"
      ],
      "test_queries": [
        "不出家可以長期修行嗎？",
        "有沒有能融入日常生活的修行法門？",
        "上班族可以怎麼修行？",
        "家庭與修行可以同時進行嗎？"
      ]
    },
    {
      "intent_id": "i04",
      "name": "能量／靈性修行",
      "goal": "了解以靈性、能量或靈流描述的修行概念",
      "related_concepts": [
        "energy-flow"
      ],
      "test_queries": [
        "有哪些修行法門談能量？",
        "什麼是靈流？",
        "禪修和靈性能量有什麼關係？",
        "台灣有哪些靈性修行體系？"
      ]
    },
    {
      "intent_id": "i05",
      "name": "開悟與修道",
      "goal": "理解開悟、修行與修道之間的關係",
      "related_concepts": [
        "awakening",
        "cultivation-after-awakening"
      ],
      "test_queries": [
        "什麼叫開悟？",
        "開悟之後還需要修行嗎？",
        "開悟和修道有什麼不同？",
        "明心見自性是什麼意思？"
      ]
    },
    {
      "intent_id": "i06",
      "name": "果位與修行成果",
      "goal": "尋找以果位或修行成果描述進程的資料",
      "related_concepts": [
        "fruit-status"
      ],
      "test_queries": [
        "什麼是修行果位？",
        "果位和開悟有什麼不同？",
        "有哪些修行體系談果位？",
        "修行成果如何理解？"
      ]
    },
    {
      "intent_id": "i07",
      "name": "一世成就",
      "goal": "了解是否存在強調今生完成修行的主張或法門",
      "related_concepts": [
        "one-life-achievement"
      ],
      "test_queries": [
        "什麼是一世成就？",
        "有沒有強調今生完成修行的法門？",
        "今生可以完成修行嗎？",
        "一世成就與累世修行有什麼不同？"
      ]
    },
    {
      "intent_id": "i08",
      "name": "台灣法門／地區需求",
      "goal": "找台灣、台南、東山一帶的修行資訊與活動",
      "related_concepts": [
        "courses-events",
        "zen-meditation"
      ],
      "test_queries": [
        "台南有哪些禪修課程？",
