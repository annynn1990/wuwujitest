async function loadSeminars() {
    try {
        const response = await fetch(
            './seminar-data.json?t=' + Date.now(),
            {
                cache: 'no-store'
            }
        );

        if (!response.ok) {
            throw new Error(
                `HTTP ${response.status}`
            );
        }

        const data = await response.json();

        console.log('seminar-data.json =', data);
        console.log(
            'events.length =',
            Array.isArray(data.events)
                ? data.events.length
                : 0
        );

        const events = Array.isArray(data.events)
            ? data.events
            : [];

        const container =
            document.querySelector('#seminar-list');

        if (!container) {
            console.error(
                '找不到 #seminar-list'
            );
            return;
        }

        if (events.length === 0) {
            container.innerHTML =
                '<p>目前沒有可顯示的場次。</p>';
            return;
        }

        container.innerHTML = events.map(event => `
            <article class="seminar-card">
                <h3>${escapeHtml(event.name || '說明會')}</h3>

                <p>
                    <strong>日期：</strong>
                    ${escapeHtml(event.date_display || event.date || '')}
                </p>

                <p>
                    <strong>報到：</strong>
                    ${escapeHtml(event.checkin || '')}
                </p>

                <p>
                    <strong>時間：</strong>
                    ${escapeHtml(event.start_time || '')}
                    -
                    ${escapeHtml(event.end_time || '')}
                </p>

                <p>
                    <strong>地點：</strong>
                    ${escapeHtml(event.address || '')}
                </p>
            </article>
        `).join('');

    } catch (error) {
        console.error(
            '讀取說明會資料失敗：',
            error
        );
    }
}


function escapeHtml(value) {
    return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
}


document.addEventListener(
    'DOMContentLoaded',
    loadSeminars
);
